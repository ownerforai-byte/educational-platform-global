#!/bin/bash
# bin/agnes — front-door for the Agnes verifier CLI.
#
# Any prompt you give here is routed through the FULL pipeline
# (planner -> implementer -> generator -> verifier) per the standing
# division-of-labor rules. It does NOT run agnes in isolation.
#
#   ./bin/agnes "verify the chemistry question set against the spec"
#   agnes "check README for formatting issues"   (if bin/ is on PATH)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROUTER_ENTRY_VIA=agnes exec "$SCRIPT_DIR/entry.sh" "$@"