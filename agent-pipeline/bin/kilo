#!/bin/bash
# bin/kilo — front-door for Kilo Code CLI.
#
# Any prompt you give here is routed through the FULL pipeline
# (planner -> implementer -> generator -> verifier) per the standing
# division-of-labor rules. It does NOT run kilo in isolation.
#
#   ./bin/kilo "generate the biology misconception question set"
#   kilo "add a Usage section to the README"   (if bin/ is on PATH)

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROUTER_ENTRY_VIA=kilo exec "$SCRIPT_DIR/entry.sh" "$@"