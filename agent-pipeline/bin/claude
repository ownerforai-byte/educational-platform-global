#!/bin/bash
# bin/claude — front-door for the Claude Code CLI.
#
# Any prompt you give here is routed through the FULL pipeline
# (planner -> implementer -> generator -> verifier) per the standing
# division-of-labor rules. It does NOT run claude in isolation.
#
#   ./bin/claude "break the Lab build-out into concrete steps"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROUTER_ENTRY_VIA=claude exec "$SCRIPT_DIR/entry.sh" "$@"