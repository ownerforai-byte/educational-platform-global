{
  "$schema": "https://turbo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "tags": ["ci"]
    },
    "typecheck": {
      "tags": ["ci"]
    },
    "test:run": {
      "tags": ["ci"]
    }
  }
}
