# Backend environment template — copy to `.env` (repo root) or `backend/.env`
# and fill in real values. `.env` is gitignored: never commit a filled-in copy,
# and never paste a real value into this file.
#
# Placeholders only. Required = the server will not serve requests without it
# in production (see backend/src/config/env.ts).

# ── Supabase (required) ────────────────────────────────────────────────────
SUPABASE_URL=
# Server-side only. Must NEVER be shipped to the browser or given a
# NEXT_PUBLIC_ prefix. Prefer a modern secret key (sb_secret_…, from Project
# Settings → API Keys) over the legacy service_role JWT: a secret key can be
# rotated or revoked on its own, and the legacy keys can be switched off
# entirely once every environment has moved to one.
SUPABASE_SERVICE_ROLE_KEY=
# Public-safe ONLY while Row Level Security is enabled on every table.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=

# ── HTTP / CORS ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated allowlist of browser origins allowed to call this API with
# credentials. Production matches these exactly (no *.vercel.app wildcard).
FRONTEND_URL=
PUBLIC_SITE_URL=

# ── Frontend-visible values (safe to expose to the browser) ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# ── AI providers (at least one key is needed for AI features) ──────────────
# All AI credentials are read through the central resolver
# (backend/src/ai/config.ts) — one place, values never logged. A missing key
# simply turns its feature off; nothing crashes at request time.
AI_PROVIDER=
AI_DEFAULT_PROVIDER=
# Agnes (https://apihub.agnes-ai.com) — first link of the AI chain; also
# powers image generation.
AGNES_API_KEY=
AGNES_API_URL=
AGNES_MODEL=
AGNES_TIMEOUT_MS=
AI_CHAIN_BUDGET_MS=
# Groq (https://console.groq.com) — optional second chain link.
GROQ_API_KEY=
GROQ_MODEL=
# Cerebras (https://cloud.cerebras.ai) — optional chain link.
CEREBRAS_API_KEY=
CEREBRAS_MODEL=
# Google Gemini (https://aistudio.google.com) — optional chain link / figures.
GEMINI_API_KEY=
GEMINI_MODEL=
# Cloudflare Workers AI (dash.cloudflare.com → API Tokens) — optional third
# chain link. CLOUDFLARE_API_KEY is accepted as a legacy alias; the account id
# falls back to R2_ACCOUNT_ID so one account drives both layers.
CF_AI_KEY=
CLOUDFLARE_API_KEY=
CF_ACCOUNT_ID=
CF_MODEL=
# Free-tier fallbacks (github.com/open-free-llm-api/awesome-free-llm-apis).
# Every one is OpenAI-compatible and registers only when its key is set; they
# are appended to the chain after AI_CHAIN_ORDER and before the internal
# engine, so they answer only when the links above fail. LLM7.io works with NO
# key at all — leave LLM7_API_KEY blank to use its free tier. Set
# FREE_LLM_DISABLED=1 to keep the whole pool out of the chain.
FREE_LLM_DISABLED=
FREE_LLM_MAX_OUTPUT_TOKENS=
FREE_LLM_TIMEOUT_MS=
LLM7_API_KEY=
LLM7_MODEL=
OVH_AI_API_KEY=
OVH_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_MODEL=
MISTRAL_API_KEY=
MISTRAL_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
SAMBANOVA_API_KEY=
SAMBANOVA_MODEL=
MODELSCOPE_API_KEY=
MODELSCOPE_MODEL=
SILICONFLOW_API_KEY=
SILICONFLOW_MODEL=
HF_TOKEN=
HF_MODEL=

# ── Web search engines (optional — any ONE enables real-time search; the
# engine rotates across whichever are set) ──────────────────────────────────
# Tavily — https://app.tavily.com
TAVILY_API_KEY=
# Exa — https://exa.ai
EXA_API_KEY=
# Firecrawl — https://firecrawl.dev
FIRECRAWL_API_KEY=
# Jina (s.jina.ai search) — https://jina.ai
JINA_API_KEY=
# You.com (ydc-index.io search) — https://you.com
YDC_API_KEY=

# ── Diagram sources (optional) ─────────────────────────────────────────────
# Wikimedia Commons diagrams need no key. Google Images is an OPTIONAL second
# source, handed to the tutor as VISUAL REFERENCE only (never as syllabus
# truth). Enable it by supplying BOTH values from a Programmable Search Engine
# (programmablesearchengine.google.com) with Image search ON:
#   GOOGLE_CSE_API_KEY=   (from Google Cloud → Credentials → API key)
#   GOOGLE_CSE_CX=        (the search engine's "cx" id)
# GOOGLE_DIAGRAMS=off disables it even when both are set.
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_CX=
GOOGLE_DIAGRAMS=

# ── Rate limiting (optional — built-in defaults shown) ─────────────────────
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
# login / signup / refresh attempts per IP per window.
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# password reset attempts per IP (30x longer window than the tiers above).
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000

# ── Debug (leave unset; never enable in production) ────────────────────────
# "true" prints the registered route table at boot.
ROUTE_DEBUG=
