# Backend environment template — copy to `.env` (repo root) or `backend/.env`
# and fill in real values. `.env` is gitignored: never commit a filled-in copy,
# and never paste a real value into this file.
#
# Placeholders only. Required = the server will not serve requests without it
# in production (see backend/src/config/env.ts).

# ── Supabase (required) ────────────────────────────────────────────────────
SUPABASE_URL=
# Server-side only. Must NEVER be shipped to the browser or given a
# NEXT_PUBLIC_ prefix. Prefer a modern secret key (sb_secret_…, from Project
# Settings → API Keys) over the legacy service_role JWT: a secret key can be
# rotated or revoked on its own, and the legacy keys can be switched off
# entirely once every environment has moved to one.
SUPABASE_SERVICE_ROLE_KEY=
# Public-safe ONLY while Row Level Security is enabled on every table.
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=

# ── HTTP / CORS ────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Comma-separated allowlist of browser origins allowed to call this API with
# credentials. Production matches these exactly (no *.vercel.app wildcard).
FRONTEND_URL=
PUBLIC_SITE_URL=

# ── Frontend-visible values (safe to expose to the browser) ────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# ── AI providers (at least one key is needed for AI features) ──────────────
AI_PROVIDER=
AI_DEFAULT_PROVIDER=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
AGNES_API_KEY=
AGNES_API_URL=
AGNES_MODEL=
AGNES_TIMEOUT_MS=
AI_CHAIN_BUDGET_MS=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_SEARCH_GROUNDING=
TAVILY_API_KEY=

# ── Rate limiting (optional — built-in defaults shown) ─────────────────────
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_MS=60000
# login / signup / refresh attempts per IP per window.
AUTH_RATE_LIMIT_MAX_REQUESTS=5
# password reset attempts per IP (30x longer window than the tiers above).
PASSWORD_RESET_RATE_LIMIT_MAX_REQUESTS=3
PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000

# ── Debug (leave unset; never enable in production) ────────────────────────
# "true" prints the registered route table at boot.
ROUTE_DEBUG=
