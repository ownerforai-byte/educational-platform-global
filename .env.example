# Supabase (public, safe to expose in the browser — anon key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# AI Provider
AI_PROVIDER=internal
GEMINI_API_KEY=your-gemini-api-key

# Database (Neon Postgres)
DATABASE_URL=postgresql://user:password@ep-host-region.aws.neon.tech/neondb?sslmode=require

SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

OWNER_EMAIL_1=owner1@example.com
OWNER_PASSWORD_1=change-me-min-8-chars
OWNER_EMAIL_2=owner2@example.com
OWNER_PASSWORD_2=change-me-min-8-chars
OWNER_EMAIL_3=owner3@example.com
OWNER_PASSWORD_3=change-me-min-8-chars

# Origin used by server-side loadData() fetches of /data/*.json (set to your production URL, e.g. https://your-site.pages.dev)
NEXT_PUBLIC_SITE_URL=
