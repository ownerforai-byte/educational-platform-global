# .graphifyignore — directories graphify should not index
# Keep the graph focused on actual source code + agent docs, not data payloads.
#
# NOTE: This graph is built with the SQL extra installed, so the 12 Supabase
# migrations under backend/src/db/migrations/*.sql ARE indexed (tables, views,
# relations). To rebuild a fresh graph you must install graphify with the [sql]
# extra:  uv tool install "graphifyy[sql]"  (plain `graphify` skips .sql files).

# Curriculum corpus (4,300+ JSON files — data, not code)
content/
public/
frontend/public/

# OCR / KB corpora
backend/.ocr-v2/
backend/kb/

# Build output & generated data
*/node_modules/
frontend/.next/
.next/
backend/dist/
*.map

# Play Store / TWA binaries
play-store/
android-twa/

# Graphify's own output
graphify-out/
