cell-architecture-studio/

# local API tokens (never commit)
cloudflare-token.txt


# ── Android TWA wrapper (local build only; signing keys and build trees stay out) ──
android-twa/node_modules/
android-twa/android/
android-twa/android/local.properties
android-twa/*.aab
android-twa/android-keystore.jks
android-twa/keystore.jks
android-twa/*.jks
android-twa/*.keystore
android-twa/release/

# Broad guard: anything under the TWA wrapper or local build tooling stays out
# even if it does not match the named patterns above.
android-twa/
tools/

# ── worktree-flow sandboxes (cline/* branches; see scripts/worktree-flow.mjs) ──
.worktrees/
