# ── secrets and credentials — never commit ──────────────────────────────────
# local env files (keep only the .example templates)
.env
.env.*
*.env
!.env.example
.env*.local
# env dumps that do NOT match the .env patterns above but hold the same
# live secrets (Supabase service-role key, AI provider keys) — never commit
/env2
/env2.*
/env[0-9]
/env[0-9].*
/env.bak
/env.old
.mcp.json

# agent/deploy tokens kept in the working tree
vercel-token.txt
*-token.txt
*token*.txt
*.token.json
credentials*.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
*.aab
*.apk
*.class
**/build/
**/.gradle/

