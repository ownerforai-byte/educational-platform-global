# ── Server ────────────────────────────────────────────────────────────────
# Port the Express server listens on.
PORT=3001
NODE_ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Allowed browser origin(s). Single origin OR comma-separated list.
# The request Origin is reflected only when it matches an entry (no wildcard).
FRONTEND_URL=http://localhost:5173

# ── Supabase (service role — NEVER expose to the client) ──────────────────
# Project URL, e.g. https://xyzcompany.supabase.co
SUPABASE_URL=
# Service-role key bypasses RLS; route-level checks are the only guard.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
DATABASE_URL=

# ── Supabase Storage ──────────────────────────────────────────────────────
# Default bucket for /api/storage uploads when none is specified.
SUPABASE_STORAGE_BUCKET=resources

# ── AI providers (server-side keys only) ──────────────────────────────────
GEMINI_API_KEY=
OPENROUTER_API_KEY=
AGNES_API_KEY=
# Which provider adapter to use: "gemini" | "openrouter" | "internal" | "agnes"
AI_PROVIDER=internal
AI_DEFAULT_PROVIDER=internal

# ── Rate limiting ─────────────────────────────────────────────────────────
# Sliding window length and max requests per window per IP.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
