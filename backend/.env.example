JOURNAL_LOCK_HOURS=24
# Error monitoring (Sentry — optional; no DSN, no telemetry)
# SENTRY_DSN=
# AI keys — see the root .env.example for the full documented set. Every AI
# credential is read through backend/src/ai/config.ts (values never logged;
# a missing key disables its feature): AGNES_API_KEY, GROQ_API_KEY,
# CF_AI_KEY/CLOUDFLARE_API_KEY, CF_ACCOUNT_ID, GOOGLE_CSE_API_KEY +
# GOOGLE_CSE_CX, and the web-search engines TAVILY_API_KEY, EXA_API_KEY,
# FIRECRAWL_API_KEY, JINA_API_KEY, YDC_API_KEY.
# Cloudflare R2 overflow (optional, 10GiB free + zero egress)
# R2_ACCOUNT_ID=
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PUBLIC_BASE_URL=

# AI Provider Configuration
# AI_DEFAULT_PROVIDER=groq
# AI_CHAIN_ORDER=groq,gemini,cerebras,agnes,cloudflare,internal

# Groq (OpenAI-compatible)
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# Cerebras Inference (OpenAI-compatible, ultra-fast 2000+ t/s)
# CEREBRAS_API_KEY=
# CEREBRAS_MODEL=qwen-3.8-27b

# Google Gemini (Multimodal vision & deep concept synthesis)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# Diagram Hub — DEDICATED free Google AI Studio key (aistudio.google.com/apikey).
# Gemini 3.8 Flash is "Free of charge" on the Gemini API Free Tier for input,
# output and context caching. Google Search grounding is NOT on the free tier,
# so diagram research stays server-side (buildProfessorContext / Google CSE).
# Falls back to GEMINI_API_KEY when DIAGRAM_GEMINI_API_KEY is left blank.
# DIAGRAM_GEMINI_API_KEY=
# DIAGRAM_GEMINI_MODEL=gemini-3.8-flash

# Agnes AI Gateway
# AGNES_API_KEY=
# AGNES_MODEL=agnes-3.0-flash
# Shared password that lets a Plus account open the Pro periodic table.
# PERIODIC_TABLE_PRO_PASSWORD=

# Cloudflare Workers AI
# CF_AI_KEY=
# CF_MODEL=@cf/openai/gpt-oss-20b

# Free-tier fallbacks (github.com/open-free-llm-api/awesome-free-llm-apis).
# Appended to the chain after AI_CHAIN_ORDER and before internal; a key
# registers its link. LLM7.io needs no key (free turbo tier).
# FREE_LLM_DISABLED=1
# FREE_LLM_MAX_OUTPUT_TOKENS=8192
# FREE_LLM_TIMEOUT_MS=120000
# LLM7_API_KEY=
# LLM7_MODEL=gpt-oss:20b
# OVH_AI_API_KEY=
# OVH_MODEL=meta-llama-3_3-70b-instruct

# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-3-5-128b
# NVIDIA NIM free tier (build.nvidia.com/settings/api-keys). NIM_API_KEY is
# accepted as an alias. Leave the model unset to use the registry default:
# nvidia/nemotron-3-ultra-550b-a55b — NVIDIA's frontier model, free endpoint,
# 1M context, verified streaming 2026-11-12. The old z-ai/glm-5.2 default was
# retired by NVIDIA (HTTP 410).
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# SAMBANOVA_API_KEY=
# SAMBANOVA_MODEL=Meta-Llama-3.3-70B-Instruct
# MODELSCOPE_API_KEY=
# MODELSCOPE_MODEL=Qwen/Qwen3.5-35B-A3B
# SILICONFLOW_API_KEY=
# SILICONFLOW_MODEL=Qwen/Qwen3-8B
# HF_TOKEN=
# HF_MODEL=Qwen/Qwen3-8B
