{
  "name": "educational-platform-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/ensure-deps.mjs && tsc && node scripts/fix-esm-imports.mjs",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "smoke": "node scripts/smoke-live.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@sentry/node": "^11.9.0",
    "@supabase/supabase-js": "^2.45.4",
    "cookie-parser": "^1.4.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.0",
    "node-cron": "^4.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.5",
    "@types/node": "^20.11.0",
    "tsx": "^4.7.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.17.1",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "source-map-js": "1.2.2",
    "vite": "8.3.5",
    "@sentry/node": "11.10.0"
  }
}
