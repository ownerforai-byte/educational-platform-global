{
  "$schema": "https://repomix.com/schemas/latest/schema.json",
  "output": {
    "filePath": "repomix-output.xml",
    "style": "xml",
    "fileSummary": true,
    "directoryStructure": true,
    "files": true,
    "topFilesLength": 10,
    "git": {
      "sortByChanges": true,
      "sortByChangesMaxCommits": 100
    }
  },
  "include": ["**/*"],
  "ignore": {
    "useGitignore": true,
    "useDotIgnore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "content/**",
      "public/**",
      "frontend/public/data/**",
      "frontend/public/materials/**",
      "frontend/public/resources/**",
      "backend/kb/**",
      "backend/.ocr-v2/**",
      "graphify-out/**",
      "tokenkit-out/**",
      "repomix-output.xml",
      "android-twa/**",
      "play-store/**",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.webp",
      "**/*.gif",
      "**/*.ico",
      "**/*.pdf",
      "**/*.woff2"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  },
  "tokenCount": {
    "encoding": "o200k_base"
  }
}