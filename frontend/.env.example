NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000
# Canonical OAuth site URL. LOCAL dev uses the http value below; in production
# set the ONE stable HTTPS origin whitelisted in Supabase -> Authentication ->
# URL Configuration -> Redirect URLs. The real production site is:
#     NEXT_PUBLIC_SITE_URL=https://ravikisan.vercel.app
# NEVER paste a Vercel preview/branch URL (…-abc123-ownerforai-byte.vercel.app)
# here: those deployments get pruned, and Google sign-in then lands on
# DEPLOYMENT_NOT_FOUND ("page is removed or not exists"). The code rejects such
# hosts anyway (see lib/supabase/oauth-config.ts), but keep the dashboard value
# correct so builds stay predictable.
# Google Cloud Console must list <NEXT_PUBLIC_SUPABASE_URL>/auth/v1/callback
# as an Authorized redirect URI, or Google answers "Access blocked".
NEXT_PUBLIC_SITE_URL=http://localhost:5173
# Error monitoring (Sentry — optional; no DSN, no telemetry)
# Browser/client DSN (public by design — set on Vercel for production):
NEXT_PUBLIC_SENTRY_DSN=
# Server runtime DSN (kept private):
SENTRY_DSN=

