NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:5173

# ── Build fingerprint (used by the footer "LIVE" badge) ──────────────
# Vercel auto-injects VERCEL_GIT_COMMIT_SHA / VERCEL_URL / VERCEL_ENV at build
# time, so the footer badge works out of the box on Vercel. The one OPTIONAL
# owner-controlled knob: a monotonically increasing build counter you bump by
# hand (0,1,2,...) so you can eyeball "which deploy am I on" at a glance.
# Leave empty to fall back to the git commit short-hash instead.
NEXT_PUBLIC_BUILD_NO=

