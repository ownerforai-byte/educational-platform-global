{
  "framework": "nextjs",
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "outputDirectory": ".next",
  "ignoreCommand": "sh -c 'case $VERCEL_GIT_COMMIT_REF in dependabot/*) exit 0;; *) exit 1;; esac'",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dependabot/*": false,
      "content/*": false,
      "feature/*": false,
      "backend/*": false,
      "test/*": false,
      "ci/*": false,
      "chore/*": false,
      "docs/*": false,
      "agents/*": false,
      "claude/*": false,
      "worktree/*": false
    }
  }
}