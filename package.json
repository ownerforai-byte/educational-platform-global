{
  "name": "educational-platform-global",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build:backend": "npm run build -w backend",
    "start:backend": "npm run start -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:run": "npm run test:run -w frontend && npm run test:run -w backend",
    "start": "npm run start -w backend",
    "content:build": "node scripts/build-content.mjs",
    "blueprint": "node scripts/generate-blueprint.mjs"
  },
  "dependencies": {
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@react-three/rapier": "^2.2.0",
    "@tanstack/react-query": "^5.70.0",
    "@use-gesture/react": "^10.3.1",
    "gsap": "^3.13.0",
    "mathjs": "^13.2.3",
    "next": "^16.3.3",
    "postprocessing": "^6.39.4",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@next/eslint-plugin-next": "^16.0.0",
    "@tanstack/react-query-devtools": "^5.70.0",
    "@types/three": "^0.170.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.9.0",
    "typescript-eslint": "^8.68.0"
  }
}
