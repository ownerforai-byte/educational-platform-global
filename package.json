{
  "name": "educational-platform-global",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=educational-platform-backend",
    "build": "npm run build --workspace=educational-platform-backend",
    "build:backend": "npm run build --workspace=educational-platform-backend",
    "start": "npm run start --workspace=educational-platform-backend",
    "start:backend": "npm run start --workspace=educational-platform-backend",
    "lint": "npm run lint --workspace=educational-platform-backend",
    "test": "npm run test:run --workspace=educational-platform-backend",
    "check": "node scripts/scoped-check.mjs",
    "check:all": "node scripts/scoped-check.mjs --all",
    "check:content": "node scripts/content-health-check.mjs",
    "check:schema": "cd frontend && npm run test:run -- tests/lib/content/schema-corpus.test.ts",
    "audit:scopes": "node scripts/audit-empty-scopes.mjs",
    "audit:scopes:fail": "node scripts/audit-empty-scopes.mjs --strict",
    "audit:mindmap": "node scripts/enrichment/mindmap-validate.mjs"
  }
}
