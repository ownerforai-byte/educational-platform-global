{
  "name": "educational-platform-global",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Ravikishan's Platform — an open NEB Class 11/12 study platform: an AI tutor (Veer) grounded in real curriculum + live web + drawn figures, plus notes, labs, quizzes and PYQs for Nepali +2 students.",
  "author": {
    "name": "ownerforai"
  },
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ownerforai-byte/educational-platform-global.git"
  },
  "homepage": "https://github.com/ownerforai-byte/educational-platform-global",
  "keywords": [
    "neb",
    "education",
    "study-platform",
    "ai-tutor",
    "class-11",
    "class-12",
    "nepal"
  ],
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=educational-platform-backend",
    "dev:backend": "npm run dev --workspace=educational-platform-backend",
    "build": "npm run build --workspace=educational-platform-backend",
    "build:backend": "npm run build --workspace=educational-platform-backend",
    "build:affected": "node scripts/build/build-affected.mjs",
    "build:affected:list": "node scripts/build/build-affected.mjs --list",
    "wt": "node scripts/deploy/worktree-flow.mjs",
    "start": "npm run start --workspace=educational-platform-backend",
    "start:backend": "npm run start --workspace=educational-platform-backend",
    "lint": "npm run lint --workspace=educational-platform-backend",
    "lint:ratchet": "node scripts/ci/lint-ratchet.mjs",
    "lint:ratchet:baseline": "node scripts/ci/lint-ratchet.mjs --write-baseline",
    "ai:regression": "node scripts/ci/ai-regression.mjs --check",
    "ai:regression:build": "node scripts/ci/ai-regression.mjs --build-set",
    "ai:regression:live": "node scripts/ci/ai-regression.mjs --live",
    "smoke:env": "node scripts/ci/check-smoke-env.mjs",
    "dead-ends": "node scripts/audit/dead-end-ratchet.mjs",
    "dead-ends:baseline": "node scripts/audit/dead-end-ratchet.mjs --write-baseline",
    "test": "npm run test:run --workspace=educational-platform-backend",
    "check": "node scripts/ci/scoped-check.mjs",
    "check:all": "node scripts/ci/scoped-check.mjs --all",
    "check:core": "node scripts/build/classify-files.mjs --check-core",
    "classify": "node scripts/build/classify-files.mjs",
    "test:affected": "node scripts/ci/test-affected.mjs",
    "test:affected:list": "node scripts/ci/test-affected.mjs --list",
    "check:content": "node scripts/build/content-health-check.mjs && npm run check:schema",
    "check:schema": "cd frontend && npm run test:run -- tests/lib/content/schema-corpus.test.ts",
    "content:build": "npx tsx frontend/scripts/content/build.ts && node scripts/build/build-content-corpus.mjs",
    "content:build:check": "npx tsx frontend/scripts/content/build.ts --check && node scripts/build/build-content-corpus.mjs --check",
    "content:corpus": "node scripts/build/build-content-corpus.mjs",
    "content:corpus:check": "node scripts/build/build-content-corpus.mjs --check",
    "content:doctor": "npx tsx frontend/scripts/content/doctor.ts",
    "graphify": "node scripts/graphify.mjs",
    "graphify:update": "node scripts/graphify.mjs update .",
    "graphify:query": "node scripts/graphify.mjs query",
    "graphify:gods": "node scripts/graphify.mjs god-nodes --top 15",
    "graphify:mcp": "node scripts/graphify-mcp.mjs",
    "graphify:benchmark": "node scripts/graphify.mjs benchmark",
    "tokenkit:codegraph": "node scripts/tokenkit/codegraph.mjs",
    "tokenkit:grepai": "node scripts/tokenkit/grepai.mjs",
    "tokenkit:pack": "node scripts/tokenkit/pack.mjs",
    "tokenkit:cost": "node scripts/tokenkit/cost.mjs",
    "tokenkit:mcp": "node scripts/tokenkit/harmony-mcp.mjs",
    "registry:build": "npx tsx frontend/scripts/content/registry.ts",
    "registry:check": "npx tsx frontend/scripts/content/registry.ts --check",
    "ledger:build": "npx tsx frontend/scripts/content/ledger.ts --write",
    "ledger:check": "npx tsx frontend/scripts/content/ledger.ts --check",
    "ledger:status": "npx tsx frontend/scripts/content/ledger.ts",
    "ledger:live": "node scripts/build/content-ledger-live.mjs",
    "audit:scopes": "node scripts/audit/audit-empty-scopes.mjs",
    "audit:scopes:fail": "node scripts/audit/audit-empty-scopes.mjs --strict",
    "audit:mindmap": "node scripts/enrichment/mindmap-validate.mjs",
    "audit:visuals": "cd frontend && node ../node_modules/tsx/dist/cli.mjs scripts/audit-visuals.ts",
    "audit:lab-manifest": "cd frontend && node ../node_modules/tsx/dist/cli.mjs scripts/lab-manifest-coverage.ts",
    "mobile:check": "node scripts/audit/mobile-responsive-check.mjs",
    "mindmaps:rebuild": "node scripts/enrichment/rebuild-legacy-mindmaps.mjs",
    "mindmaps:check": "node scripts/enrichment/rebuild-legacy-mindmaps.mjs --check",
    "visuals:py": "python visuals-py/run.py generate",
    "visuals:py:images": "python visuals-py/run.py generate --images",
    "visuals:py:check": "python visuals-py/run.py check",
    "prune:vercel": "node scripts/deploy/prune-vercel-deployments.mjs",
    "prune:vercel:dry": "node scripts/deploy/prune-vercel-deployments.mjs --dry-run",
    "brief": "node scripts/agent-brief.mjs brief",
    "impact": "node scripts/agent-brief.mjs impact"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "qs": "6.17.1",
    "glob": "14.0.3",
    "minimatch": "11.0.3",
    "source-map-js": "1.2.2",
    "vite": "8.3.5",
    "@sentry/node": "11.10.0"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "turbo": "^2.11.10"
  }
}
