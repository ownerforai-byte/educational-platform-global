{
  "name": "educational-platform-global",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm run dev -w frontend",
    "dev:backend": "npm run dev -w backend",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "npm run build -w frontend && npm run build -w backend",
    "build:frontend": "npm run build -w frontend",
    "build:backend": "npm run build -w backend",
    "lint": "npm run lint -w frontend",
    "typecheck": "npm run typecheck -w frontend",
    "test": "npm run test -w frontend && npm run test -w backend",
    "test:run": "npm run test:run -w frontend && npm run test:run -w backend",
    "start": "npm run start -w backend",
    "content:build": "node scripts/build-content.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-query": "^5.62.0",
    "gsap": "^3.12.5",
    "mathjs": "^13.2.0",
    "next": "^16.3.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@tanstack/react-query-devtools": "^5.62.0",
    "@types/three": "^0.170.0",
    "concurrently": "^10.0.5",
    "typescript-eslint": "^8.68.0"
  }
}
