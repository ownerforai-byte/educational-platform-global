{
  "framework": "nextjs",
  "installCommand": "sh -c 'env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm ci --workspace=educational-platform-frontend'",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build --workspace=educational-platform-frontend",
  "outputDirectory": "frontend/.next",
  "ignoreCommand": "sh frontend/scripts/ci/vercel-should-build.sh",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "dependabot/*": false,
      "content/*": false,
      "feature/*": false,
      "backend/*": false,
      "test/*": false,
      "ci/*": false,
      "chore/*": false,
      "docs/*": false,
      "agents/*": false,
      "claude/*": false,
      "worktree/*": false
    }
  }
}